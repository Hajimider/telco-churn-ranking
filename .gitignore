# Python 缓存、测试产物与虚拟环境
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.coverage.*
.mypy_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/

# 本机编辑器与系统文件
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# 本机配置和密钥；保留配置示例
.env
.env.*
!.env.example
.streamlit/secrets.toml

# 原始数据只保留下载说明
/data/*
!/data/README.md

# 保留四份完整演示报告；新训练目录默认不提交
/outputs/*
!/outputs/project_v1/
!/outputs/project_v2/
!/outputs/run_optimized_v2/
!/outputs/run_validated/

# 模型文件和本机数据库
*.pkl
*.pickle
*.joblib
*.sqlite
*.sqlite3
*.db

# 日志和临时文件；测试会在项目根目录创建 tmp 开头的目录
/tmp*/
/temp/
*.log
*.tmp
*.bak
*.cache
*.pid
