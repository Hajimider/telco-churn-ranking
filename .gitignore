# Python 缓存、测试产物与虚拟环境
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.coverage.*
.mypy_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/

# 本机编辑器与系统文件
.idea/
.vscode/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# 本机配置和密钥；保留配置示例
.env
.env.*
!.env.example
.streamlit/secrets.toml

# 原始数据只保留下载说明
/data/*
!/data/README.md

# 保留已有报告与本轮受控验证报告；新训练目录默认不提交
/outputs/*
!/outputs/run_final/

# Codex 过程记录只保存在本地，不作为项目交付文件
/task_plan.md
/findings.md
/progress.md

# 内部审计、方案和实现过程文档不作为公开项目文件
/docs/IMPROVEMENT_PLAN.md
/docs/OPTIMIZATION_PLAN.md
/docs/superpowers/
/docs/handoff/
/telco_churn/IMPLEMENTATION_STATUS.md

# 模型文件和本机数据库
*.pkl
*.pickle
*.joblib
*.sqlite
*.sqlite3
*.db

# 日志和临时文件；测试会在项目根目录创建 tmp 开头的目录
/tmp*/
/temp/
*.log
*.tmp
*.bak
*.cache
*.pid
