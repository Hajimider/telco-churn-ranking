# 默认 SQLite 内存分群，无需数据库配置；显式 --backend mysql 才需 MySQL 8.0+。
# 复制为 .env 后填写实际密码；环境变量优先于本文件。
CHURN_MYSQL_HOST=127.0.0.1
CHURN_MYSQL_PORT=3306
CHURN_MYSQL_DATABASE=telco_churn
CHURN_MYSQL_USER=root
CHURN_MYSQL_PASSWORD=

# 可选：OpenAI 兼容远程接口。留空时看板使用离线模板解读。
CHURN_AI_BASE_URL=
CHURN_AI_MODEL=
CHURN_AI_API_KEY=
CHURN_AI_TIMEOUT_SECONDS=20
